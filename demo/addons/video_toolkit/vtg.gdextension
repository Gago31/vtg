[configuration]

entry_symbol = "vtg_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://addons/video_toolkit/bin/libvtg.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/video_toolkit/bin/libvtg.linux.template_release.x86_64.so"
macos.debug = "res://addons/video_toolkit/bin/libvtg.macos.template_debug.framework"
macos.release = "res://addons/video_toolkit/bin/libvtg.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/video_toolkit/bin/libvtg.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/video_toolkit/bin/libvtg.windows.template_release.x86_64.dll"
android.debug.arm32 = "res://addons/video_toolkit/bin/libvtg.android.template_debug.arm32.so"
android.release.arm32 = "res://addons/video_toolkit/bin/libvtg.android.template_release.arm32.so"
android.debug.arm64 = "res://addons/video_toolkit/bin/libvtg.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/video_toolkit/bin/libvtg.android.template_release.arm64.so"

[dependencies]

windows.debug.x86_64 = {
	"res://addons/video_toolkit/bin/sav1.dll": "",
	"res://addons/video_toolkit/bin/SDL2.dll": ""
}

windows.release.x86_64 = {
	"res://addons/video_toolkit/bin/sav1.dll": "",
	"res://addons/video_toolkit/bin/SDL2.dll": ""
}

